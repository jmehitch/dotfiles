# aliases
source $HOME/.config/fish/alias.fish

# disable fish greeting
set -g fish_greeting

# hack: override PAGER set by cursor for git delta
set -u PAGER

# set default editor to Vim
set -gx EDITOR vim

# yamllint config path
set -gx YAMLLINT_CONFIG_FILE "$HOME/.config/.yamllint"

# configure brew paths
if test -d /home/linuxbrew/.linuxbrew # ubuntu
    set -gx HOMEBREW_PREFIX "/home/linuxbrew/.linuxbrew"
    set -gx HOMEBREW_CELLAR "$HOMEBREW_PREFIX/Cellar"
    set -gx HOMEBREW_REPOSITORY "$HOMEBREW_PREFIX/Homebrew"
else if test -d /opt/homebrew # macos
    set -gx HOMEBREW_PREFIX "/opt/homebrew"
    set -gx HOMEBREW_CELLAR "$HOMEBREW_PREFIX/Cellar"
    set -gx HOMEBREW_REPOSITORY "$HOMEBREW_PREFIX/homebrew"
end
fish_add_path -gP "$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin"

if status is-interactive
    # activate mise
    $HOME/.local/bin/mise activate fish | source

    # Work around mise [env] MISE_ENV chicken-and-egg: when a project's
    # mise.toml sets MISE_ENV via [env] to additionally load a
    # mise.<env>.toml (e.g. oneid uses MISE_ENV=ci -> mise.ci.toml for
    # kubectl/gcloud/etc.), the first hook-env resolves tools BEFORE
    # MISE_ENV is applied, so env-specific tools are missing from PATH and
    # mise's __MISE_DIFF cache then suppresses the fix on later prompts.
    # If MISE_ENV ended up set, bust the diff and re-run hook-env once.
    if set -q MISE_ENV
        set -e __MISE_DIFF
        $HOME/.local/bin/mise hook-env -s fish | source
    end

    # activate zoxide
    zoxide init fish | source

    # activate starship
    starship init fish | source

    # task fish completions
    task --completion fish | source
end

{{ if eq .chezmoi.os "darwin" -}}
# jira api token
set -gx JIRA_API_TOKEN {{ (bitwardenFields "item" "atlassian-creds").api_token.value }}
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# github rate limit token
set -gx GITHUB_TOKEN {{ (bitwardenFields "item" "github-pat").api_token.value }}
{{ end -}}

