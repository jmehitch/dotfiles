{
  "extensions.ignoreRecommendations": true,

  "workbench.colorTheme": "GitHub Dark",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredDarkColorTheme": "GitHub Dark",
  "workbench.preferredLightColorTheme": "GitHub Light",
  "window.autoDetectColorScheme": true,
  "window.autoDetectHighContrast": false,

  "diffEditor.ignoreTrimWhitespace": false,
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "githubPullRequests.pullBranch": "never",

  "editor.accessibilitySupport": "off",
  "editor.codeLensFontSize": 1,
  "editor.cursorStyle": "line-thin",
  "editor.fontFamily": "InconsolataGo Nerd Font Mono",
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 100,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.fontFamily": "InconsolataGo Nerd Font Mono",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": ["-l"],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh",
      "args": ["-l"]
    },
    "fish": {
      "path": "fish",
      "args": ["-l"]
    },
    "tmux": {
      "path": "tmux",
      "args": ["new-session", "-A", "-s", "cursor:${workspaceFolder}"]
    }
  },

  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.composer.usageSummaryDisplay": "always",
  "cursor.cpp.enablePartialAccepts": true,

  "cSpell.allowCompoundWords": true,
  "cSpell.userWords": [
    "consentconsole",
    "ctxutils",
    "endtoend",
    "firestore",
    "GOBIN",
    "GOPKG",
    "idpconfig",
    "managementconsole",
    "myoneid",
    "oneid",
    "rpconfig",
    "taskfile"
  ],

  "go.toolsManagement.autoUpdate": true,
  "redhat.telemetry.enabled": false,
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "disabled"
  },

  "yaml.format.printWidth": 10000,
  "yaml.format.singleQuote": true,
  "yaml.schemas": {
    "https://www.schemastore.org/yamllint.json": [
      "file:///Users/jamie/code/oneid/infrastructure/kubernetes/envs/din-internal/internal-europe-west2/charts/arc.yaml",
      "file:///Users/jamie/code/oneid/infrastructure/kubernetes/envs/din-internal/internal-europe-west2/charts/loki.yaml",
      "file:///Users/jamie/code/oneid/infrastructure/kubernetes/envs/din-internal/internal-europe-west2/charts/values/arc.yaml",
      "file:///Users/jamie/code/oneid/infrastructure/kubernetes/envs/din-internal/internal-europe-west2/charts/values/loki.yaml",
      "file:///Users/jamie/code/oneid/kubernetes/din-dev-lab/dev-lab-europe-west2/skaffold/infra/bank-id-redirect-httproute.yaml"
    ]
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": true,
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.detectIndentation": false,
    "editor.tabSize": 2
  },
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[helm]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  }
}
